<%- include("partials/head.ejs") %>

<main class="login-container">

	<h3 class="centrado"> <%= about %> </h3>
	
	<!-- Formulario de login 
	
		action: Apunta a la ruta a donde enviar los datos
		
		method: Indica el metodo HTTP para enviar los datos

		En nuestro endpoint que atienda peticiones POST a /login, podremos recibir estos datos urlencoded como objetos gracias a

		app.use(express.urlencoded({extended: true}));
	-->
	<form id="login-form" action="/login" method="POST">
		<label for="emailUser">Email</label>
		<input type="email" name="email" id="emailUser" required>

		<label for="passwordUser">Password</label>
		<input type="password" name="password" id="passwordUser" required>

		<input type="submit" value="Login">
	</form>

	<!-- Si renderizo la plantilla login enviandole un error, se muestra aca -->
	<% if (typeof error !== "undefined") { %>
		<p class="mensaje error centrado"> <%= error %> </p>
	<% } %>

</main>

<%- include("partials/footer.ejs") %>
